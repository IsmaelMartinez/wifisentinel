<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon. minSdk is 29 (adaptive icons exist since 26), so no
  legacy raster fallback is needed. The monochrome layer (Android 13+ themed
  icons) reuses the foreground — it is a single-colour alpha mask already.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
